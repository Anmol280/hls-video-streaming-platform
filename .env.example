# Local development only. Replace this before any deployment.
NODE_ENV=development
JWT_SECRET=local-dev-secret-change-this-before-deploy

# Host-side migration tooling; Compose services use the postgres/redis service names.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hls_platform
REDIS_URL=redis://localhost:6379

# docker-compose.dev.yml uses local shared storage and these upload limits.
MAX_FILE_SIZE=524288000
MAX_BULK_FILES=2
MAX_THUMBNAIL_SIZE=5242880
STREAM_RATE_LIMIT=3000

# Public URLs are embedded in the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STREAMING_URL=http://localhost:3005

# Production S3 configuration (leave blank for local Compose storage).
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
